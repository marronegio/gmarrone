# Copy to .env.local (git-ignored). The deploy reads the same names from GitHub secrets.

# Supabase > Project Settings > API. The publishable key is meant for the browser;
# the secret / service_role key must never go here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Folder that serves the panel in production. The repo is public, so it stays out of
# the source. Without it the panel is not published. In dev the panel is at /painel/.
PAINEL_SLUG=
